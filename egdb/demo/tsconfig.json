{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "egdb-client": [
        "../client/src/index.ts"
      ],
      "egdb-client/react": [
        "../client/src/react/index.tsx"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "src"
  ]
}
