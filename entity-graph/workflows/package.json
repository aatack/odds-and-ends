{
  "name": "workflows",
  "productName": "YAWN",
  "version": "0.1.0",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev -- --no-sandbox",
    "start": "electron-vite build && electron . --no-sandbox",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "test": "tsx test/engine.mts && tsx test/egdb.mts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "backend": "node scripts/egdb-server.mjs && electron-vite build && node out/main/backend.js",
    "egdb:build": "node scripts/egdb-server.mjs --force",
    "prestart": "node scripts/egdb-server.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@untitledui/icons": "^0.0.22",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.0",
    "electron-vite": "^2.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.0",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@floating-ui/react-dom": "^2.1.9",
    "@fontsource-variable/crimson-pro": "^5.3.0",
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "egdb-client": "file:../../egdb/client",
    "fuzzysort": "^3.1.0",
    "jotai": "^2.10.3",
    "lucide-react": "^0.468.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-to-string": "^4.0.0",
    "prism-react-renderer": "^2.4.1",
    "quickjs-emscripten": "^0.32.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.25.2"
  }
