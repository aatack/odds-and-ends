{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src/main/**/*", "src/backend/**/*", "src/engine/**/*", "src/preload/**/*", "src/shared/**/*", "test/**/*", "electron.vite.config.ts"]
}
