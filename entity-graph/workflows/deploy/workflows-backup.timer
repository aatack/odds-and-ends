# Fires workflows-backup.service once a day.
# Installed by deploy/install.sh to /etc/systemd/system/workflows-backup.timer;
# enable with `systemctl enable --now workflows-backup.timer`.

[Unit]
Description=Daily YAWN workflows backup

[Timer]
OnCalendar=daily
# A run missed while the box was off happens at the next boot.
Persistent=true

[Install]
WantedBy=timers.target
