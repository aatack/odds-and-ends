{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": { "@core/*": ["./src/core/*"] }
  },
  // The state layer is here on purpose: with only the ES libs available,
  // reaching for the DOM from it fails to compile.
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/core/**/*",
    "src/renderer/src/state/**/*",
    "test/**/*",
    "electron.vite.config.ts"
  ]
}
